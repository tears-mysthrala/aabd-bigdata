# Plantilla: copiar a .env (`cp .env.example .env`) y levantar con `docker compose up -d`.
# Plantilla sin secretos: generar valores aleatorios distintos antes de arrancar,
# incluso en el laboratorio (p.ej. `openssl rand -hex 24`).
# Las publicaciones del host están en 127.0.0.1. El .env real NO se versiona.

# MySQL
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=retail_db
MYSQL_USER=iabd
MYSQL_PASSWORD=
MYSQL_PORT=3306

# MongoDB: sin auth en este lab (solo 127.0.0.1 + red docker).
# Si activas auth, ajusta también la URI en los PutMongo de NiFi.
MONGO_PORT=27017

# NiFi single-user login (mínimo 12 caracteres).
NIFI_USER=nifi
NIFI_PASSWORD=
NIFI_HTTPS_PORT=8443
NIFI_HEAP_MAX=2g

# Clave de props sensibles de NiFi (>=12 caracteres).
NIFI_SENSITIVE_PROPS_KEY=
# Frontal nginx (puertos 80/443) vive en infra/.env.example.
