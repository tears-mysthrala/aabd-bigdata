# Plantilla: copiar a .env (`cp .env.example .env`) y levantar con `docker compose up -d`.
# Valores = defaults de clase (docentes/tipificados). SOLO-LAB: todo atado a
# 127.0.0.1 (ver docker-compose.yml). Fuera del lab, genera claves aleatorias
# (p.ej. `openssl rand -hex 24`) y no reutilices estas. El .env real NO se versiona.

# MySQL (docente/tipificado clase)
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=retail_db
MYSQL_USER=iabd
MYSQL_PASSWORD=iabd
MYSQL_PORT=3306

# MongoDB: sin auth en este lab (solo 127.0.0.1 + red docker).
# El stack docente de referencia usa admin:admin123; si activas auth,
# ajusta también la URI en los PutMongo de NiFi.
MONGO_PORT=27017

# NiFi single-user login (mínimo 12 caracteres).
NIFI_USER=nifi
NIFI_PASSWORD=nifinifinifi12
NIFI_HTTPS_PORT=8443
NIFI_HEAP_MAX=2g

# Clave de props sensibles de NiFi (>=12 caracteres). Cambiar siempre fuera del lab.
NIFI_SENSITIVE_PROPS_KEY=clase-iabd-labad12
# Frontal nginx (puertos 80/443) vive en infra/.env.example.
